@page "/productos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IProducto ProductoService
@inject NavigationManager Navigation
@using System.Text.Json

<div class="productos-page">
    <h3 class="mb-3">Productos</h3>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-@messageType alert-dismissible fade show" role="alert">
            @message
            <button type="button" class="btn-close" @onclick="() => message = null"></button>
        </div>
    }

    <div class="toolbar-card mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-success btn-sm" @onclick="AgregarProducto" disabled="@isLoading">
                <i class="bi bi-plus-circle"></i> Agregar
            </button>
            <button class="btn btn-primary btn-sm" @onclick="() => EditarProducto()" disabled="@(isLoading || selectedId == null)">
                <i class="bi bi-pencil"></i> Editar
            </button>
            <button class="btn btn-danger btn-sm" @onclick="EliminarProducto" disabled="@(isLoading || selectedId == null)">
                <i class="bi bi-trash"></i> Eliminar
            </button>

            <div class="vr mx-2"></div>

            <select class="form-select form-select-sm" style="width:auto" @bind="campoFiltro">
                <option value="Nombre">Nombre</option>
                <option value="Id">Id</option>
                <option value="Sku">Sku</option>
                <option value="Codigo barras">Codigo barras</option>
            </select>

            <select class="form-select form-select-sm" style="width:auto" @bind="tipoFiltro">
                <option value="Inicia con">Inicia con</option>
                <option value="Igual a">Igual a</option>
                <option value="Contiene">Contiene</option>
            </select>

            <input type="text" class="form-control form-control-sm" style="width:200px"
                   @bind="textoBuscar" placeholder="Buscar..."
                   @onkeydown="HandleKeyDown" />

            <button class="btn btn-outline-secondary btn-sm" @onclick="BuscarProductos" disabled="@isLoading">
                <i class="bi bi-search"></i> Buscar
            </button>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted mt-2">Cargando productos...</p>
        </div>
    }
    else
    {
        <div class="table-scroll-container">
            <table class="table table-striped table-hover table-sm mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Id</th>
                        <th>Sku</th>
                        <th>Código b</th>
                        <th>Nombre</th>
                        <th>Stock</th>
                        <th>Costo</th>
                        <th>Precio</th>
                        <th>% Margen</th>
                        <th>Tributo</th>
                        <th>Impuesto</th>
                        <th>Inventariable</th>
                        <th>Unidad m</th>
                        <th>Marca</th>
                        <th>Categoría</th>
                    </tr>
                </thead>
                <tbody>
                    @if (productos != null && productos.Any())
                    {
                        @foreach (var p in productos)
                        {
                            <tr class="@(selectedId == p.IdProducto ? "table-active" : "")"
                                @onclick="() => Seleccionar(p.IdProducto)"
                                @ondblclick="() => EditarProducto(p.IdProducto)">
                                <td>@p.IdProducto</td>
                                <td>@p.Sku</td>
                                <td>@p.CodigoBarras</td>
                                <td>@p.Nombre</td>
                                <td>@p.Stock</td>
                                <td>@p.CostoBase</td>
                                <td>@p.PrecioBase</td>
                                <td>@p.Margen</td>
                                <td>@p.NombreTributo</td>
                                <td>@p.Impuesto</td>
                                <td>@(p.EsInventariable ? "Si" : "No")</td>
                                <td>@p.NombreUnidadMedida</td>
                                <td>@p.NombreMarca</td>
                                <td>@p.NombreCategoria</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="14" class="text-center text-muted py-4">
                                No hay productos para mostrar
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ProductoDto> productos = new();
    private int? selectedId;
    private string textoBuscar = "";
    private string campoFiltro = "Nombre";
    private string tipoFiltro = "Inicia con";
    private bool isLoading;
    private string? message;
    private string messageType = "info";

    protected override async Task OnInitializedAsync()
    {
        await BuscarProductos();
    }

    private async Task BuscarProductos()
    {
        isLoading = true;
        message = null;
        productos = new();

        try
        {
            if (campoFiltro == "Id" && !string.IsNullOrWhiteSpace(textoBuscar))
            {
                if (!int.TryParse(textoBuscar, out _))
                {
                    message = "Ingrese un valor numérico para buscar por Id";
                    messageType = "warning";
                    isLoading = false;
                    return;
                }
            }

            var resp = await ProductoService.Buscar(textoBuscar, campoFiltro, tipoFiltro);
            object? data = resp?.Data;

            if (data != null)
            {
                var json = JsonSerializer.Serialize(data);
                var lista = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(json);

                if (lista != null && lista.Count > 0)
                {
                    productos = MapProductos(lista);
                    return;
                }

                if (campoFiltro == "Codigo barras" && !string.IsNullOrWhiteSpace(textoBuscar))
                {
                    var respCB = await ProductoService.ListCodigoBarras2(textoBuscar);
                    object? dataCB = respCB?.Data;
                    if (dataCB != null)
                    {
                        var jsonCB = JsonSerializer.Serialize(dataCB);
                        var listaCB = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(jsonCB);
                        if (listaCB != null && listaCB.Count > 0)
                        {
                            var idPrd = GetInt(listaCB[0], "IdProducto");
                            var respFn = await ProductoService.Buscar(idPrd.ToString(), "Id", "Igual a");
                            object? dataFn = respFn?.Data;
                            if (dataFn != null)
                            {
                                var jsonFn = JsonSerializer.Serialize(dataFn);
                                var listaFn = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(jsonFn);
                                if (listaFn != null && listaFn.Count > 0)
                                {
                                    productos = MapProductos(listaFn);
                                }
                            }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            message = "Error al buscar productos: " + ex.Message;
            messageType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task EliminarProducto()
    {
        if (selectedId == null) return;

        if (!await Confirmar("¿Está seguro que desea eliminar el producto seleccionado?"))
            return;

        isLoading = true;
        message = null;

        try
        {
            var resp = await ProductoService.Eliminar(selectedId.Value);
            bool flag = resp != null ? resp.Flag : false;
            string? msg = resp?.Message;

            if (resp != null && flag)
            {
                message = msg ?? "Producto eliminado correctamente";
                messageType = "success";
                selectedId = null;
                await BuscarProductos();
            }
            else
            {
                message = msg ?? "Error al eliminar el producto";
                messageType = "danger";
            }
        }
        catch (Exception ex)
        {
            message = "Error: " + ex.Message;
            messageType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AgregarProducto()
    {
        Navigation.NavigateTo("/productos/form");
    }

    private void EditarProducto(int? id = null)
    {
        var productId = id ?? selectedId;
        if (productId == null) return;
        Navigation.NavigateTo($"/productos/form/{productId}");
    }

    private void Seleccionar(int id)
    {
        selectedId = selectedId == id ? null : id;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await BuscarProductos();
        }
    }

    private async Task<bool> Confirmar(string mensaje)
    {
        return await Task.FromResult(true);
    }

    private static List<ProductoDto> MapProductos(List<Dictionary<string, object>> lista)
    {
        return lista.Select(item => new ProductoDto
        {
            IdProducto = GetInt(item, "IdProducto"),
            Sku = GetString(item, "Sku"),
            CodigoBarras = GetString(item, "CodigoBarras"),
            Nombre = GetString(item, "Nombre"),
            Stock = GetDecimal(item, "Stock"),
            CostoBase = "$ " + GetDecimal(item, "CostoBase").ToString("N2"),
            PrecioBase = "$ " + GetDecimal(item, "PrecioBase").ToString("N2"),
            Margen = CalcularMargen(GetDecimal(item, "CostoBase"), GetDecimal(item, "PrecioBase")),
            NombreTributo = GetString(item, "NombreTributo"),
            Impuesto = GetDecimal(item, "Impuesto").ToString("N0"),
            EsInventariable = GetInt(item, "EsInventariable") == 1,
            NombreUnidadMedida = GetString(item, "NombreUnidadMedida"),
            NombreMarca = GetString(item, "NombreMarca"),
            NombreCategoria = GetString(item, "NombreCategoria"),
        }).ToList();
    }

    private static string CalcularMargen(decimal costo, decimal precio)
    {
        if (precio == 0) return "0.00 %";
        var margen = ((precio - costo) / precio) * 100;
        return margen.ToString("N2") + " %";
    }

    private static int GetInt(Dictionary<string, object> dict, string key)
    {
        if (dict.TryGetValue(key, out var val))
        {
            if (val is JsonElement je)
            {
                if (je.ValueKind == JsonValueKind.Number) return je.GetInt32();
                if (int.TryParse(je.GetRawText(), out var i)) return i;
            }
            if (val is int iv) return iv;
            if (int.TryParse(val?.ToString(), out var ip)) return ip;
        }
        return 0;
    }

    private static string GetString(Dictionary<string, object> dict, string key)
    {
        if (dict.TryGetValue(key, out var val))
        {
            if (val is JsonElement je)
            {
                if (je.ValueKind == JsonValueKind.String) return je.GetString() ?? "";
                if (je.ValueKind == JsonValueKind.Null) return "";
                return je.GetRawText();
            }
            return val?.ToString() ?? "";
        }
        return "";
    }

    private static decimal GetDecimal(Dictionary<string, object> dict, string key)
    {
        if (dict.TryGetValue(key, out var val))
        {
            if (val is JsonElement je)
            {
                if (je.ValueKind == JsonValueKind.Number)
                {
                    if (je.TryGetDecimal(out var d)) return d;
                }
                if (decimal.TryParse(je.GetRawText(), out var dp)) return dp;
            }
            if (val is decimal dv) return dv;
            if (decimal.TryParse(val?.ToString(), out var dpr)) return dpr;
        }
        return 0;
    }

    private class ProductoDto
    {
        public int IdProducto { get; set; }
        public string Sku { get; set; } = "";
        public string CodigoBarras { get; set; } = "";
        public string Nombre { get; set; } = "";
        public decimal Stock { get; set; }
        public string CostoBase { get; set; } = "";
        public string PrecioBase { get; set; } = "";
        public string Margen { get; set; } = "";
        public string NombreTributo { get; set; } = "";
        public string Impuesto { get; set; } = "";
        public bool EsInventariable { get; set; }
        public string NombreUnidadMedida { get; set; } = "";
        public string NombreMarca { get; set; } = "";
        public string NombreCategoria { get; set; } = "";
    }
}
